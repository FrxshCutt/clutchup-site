# Cloudflare Pages / Netlify response headers.
# Ignored by GitHub Pages (which serves its own headers) — harmless to keep.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), midi=(), serial=(), bluetooth=(), display-capture=(), xr-spatial-tracking=()
  # HSTS. Netlify already sends this because "Force HTTPS" is on, but an
  # automatic header is invisible in review and disappears the moment the site
  # moves host — so it is pinned here as well (a duplicate identical value is
  # harmless; Netlify does not double it).
  # includeSubDomains: nothing is served from a subdomain today, and pinning it
  # now prevents a future http-only subdomain being reachable.
  # NO preload — deliberately. Preload is a one-way door: removal takes months
  # of browser-release lag, and it would commit every future subdomain to HTTPS
  # forever. Revisit once the domain layout is settled.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # The site is a set of static documents with no cross-origin embedding and no
  # window.opener relationships worth keeping.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # style-src keeps 'unsafe-inline' because the pages use style="" attributes
  # for one-off spacing (35 of them across index/how-it-works/pricing); CSP
  # cannot hash attribute styles, so removing it means moving every one into
  # the stylesheet. Script injection is the real risk and script-src is strict,
  # so this is a deliberate, bounded exception rather than an oversight.
  # The script-src hash covers the one inline bootstrap in every page's <head>:
  #   <script>document.documentElement.className+=" js"</script>
  # If you ever change that line, recompute the hash or the reveals stop working:
  #   printf '%s' 'document.documentElement.className+=" js"' | openssl dgst -sha256 -binary | openssl base64
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-pfgOMgfVZwm2ODyms34QYW9h8EwicylhV77q5LHK8c0='; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Fingerprint-free assets: revalidate rather than cache forever, so a CSS or JS
# change goes live immediately instead of being pinned for a year.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
# A week is fine for images that never change in place. BEWARE: Netlify applies
# this header to 404s under this path as well, so a <img src> pointing at a file
# that is not committed yet gets "missing, for seven days" cached in every
# visitor's browser, and shipping the file later does not reach them. That
# happened on 16 Sep 2026. `npm run build` now runs scripts/check-links.mjs,
# which fails the build on any src that does not resolve; the mount photos also
# carry content hashes so a changed photo always gets a new URL.
/assets/img/*
  Cache-Control: public, max-age=604800
